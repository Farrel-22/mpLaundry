@model List<MLayanan>
@{
    ViewData["Title"] = "Daftar Layanan";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-gear"></i> Daftar Layanan</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Tambah Layanan
    </a>
</div>

<!-- ═══════════ FORM PENCARIAN ═══════════ -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="col-form-label">
                    <i class="bi bi-search"></i> Cari:
                </label>
            </div>
            <div class="col-md-4">
                <input type="text" name="cari" value="@ViewBag.Cari"
                       class="form-control form-control-sm"
                       placeholder="Kode atau nama layanan..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary">Cari</button>
                @if (!string.IsNullOrEmpty(ViewBag.Cari as string))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- ═══════════ TABEL DATA ═══════════ -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-primary">
                <tr>
                    <th style="width:50px">#</th>
                    <th>Kode</th>
                    <th>Nama Layanan</th>
                    <th class="text-center">Satuan</th>
                    <th class="text-end">Harga</th>
                    <th class="text-center">Estimasi</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" style="width:200px">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox"></i> Belum ada data layanan.
                        </td>
                    </tr>
                }
                else
                {
                    var no = 1;
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(no++)</td>
                            <td><code>@item.TxtKodeLayanan</code></td>
                            <td>@item.TxtNamaLayanan</td>
                            <td class="text-center">@item.TxtSatuan</td>
                            <td class="text-end">@Format.Rupiah(item.DecHarga)</td>
                            <td class="text-center">@item.IntEstimasiHari hari</td>
                            <td class="text-center">
                                @if (item.BolActive)
                                {
                                    <span class="badge badge-aktif">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-nonaktif">Nonaktif</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.PkLayananId"
                                   class="btn btn-sm btn-outline-info" title="Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.PkLayananId"
                                   class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.PkLayananId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Yakin hapus layanan @item.TxtNamaLayanan?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="text-muted small mt-2">
    Total: @Model.Count layanan
</div>

