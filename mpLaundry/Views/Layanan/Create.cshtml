@model MLayanan
@{
    ViewData["Title"] = "Tambah Layanan";
}

<h4 class="mb-3"><i class="bi bi-plus-circle"></i> Tambah Layanan Baru</h4>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TxtKodeLayanan" class="form-label"></label>
                    <input asp-for="TxtKodeLayanan" class="form-control"
                           placeholder="Contoh: LY001" maxlength="10" />
                    <span asp-validation-for="TxtKodeLayanan" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TxtNamaLayanan" class="form-label"></label>
                    <input asp-for="TxtNamaLayanan" class="form-control"
                           placeholder="Contoh: Cuci Setrika" maxlength="100" />
                    <span asp-validation-for="TxtNamaLayanan" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="TxtSatuan" class="form-label"></label>
                    <select asp-for="TxtSatuan" class="form-select">
                        <option value="KG">KG (Kilogram)</option>
                        <option value="PCS">PCS (Satuan/Pieces)</option>
                    </select>
                    <span asp-validation-for="TxtSatuan" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DecHarga" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">Rp</span>
                        <input asp-for="DecHarga" class="form-control" type="number"
                               min="1" step="500" placeholder="0" />
                    </div>
                    <span asp-validation-for="DecHarga" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IntEstimasiHari" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="IntEstimasiHari" class="form-control" type="number"
                               min="1" max="30" />
                        <span class="input-group-text">hari</span>
                    </div>
                    <span asp-validation-for="IntEstimasiHari" class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Simpan
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Batal
                </a>
            </div>
        </form>
    </div>
</div>

