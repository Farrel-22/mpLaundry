@{
    ViewData["Title"] = "Beranda";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary">
        <i class="bi bi-droplet-fill"></i> Bersih Laundry
    </h1>
    <p class="lead text-muted mt-3">
        Sistem Informasi Manajemen Laundry — ASP.NET Core MVC (.NET 10)
    </p>
    <hr class="my-4" />

    <div class="row justify-content-center g-4 mt-2">
        <div class="col-md-3">
            <div class="card text-center p-4">
                <i class="bi bi-gear display-4 text-primary"></i>
                <h5 class="mt-3">Master Layanan</h5>
                <p class="text-muted small">Kelola jenis layanan & harga</p>
                <a asp-controller="Layanan" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Buka <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-4">
                <i class="bi bi-people display-4 text-success"></i>
                <h5 class="mt-3">Master Pelanggan</h5>
                <p class="text-muted small">Kelola data pelanggan</p>
                <a asp-controller="Pelanggan" asp-action="Index" class="btn btn-outline-success btn-sm">
                    Buka <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-4">
                <i class="bi bi-receipt display-4 text-warning"></i>
                <h5 class="mt-3">Order Laundry</h5>
                <p class="text-muted small">Buat & kelola order cucian</p>
                <a asp-controller="Order" asp-action="Index" class="btn btn-outline-warning btn-sm">
                    Buka <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

