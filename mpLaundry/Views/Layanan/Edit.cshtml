@model MLayanan
@{
    ViewData["Title"] = "Edit Layanan";
}

<h4 class="mb-3"><i class="bi bi-pencil-square"></i> Edit Layanan</h4>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PkLayananId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TxtKodeLayanan" class="form-label"></label>
                    <input asp-for="TxtKodeLayanan" class="form-control" maxlength="10" />
                    <span asp-validation-for="TxtKodeLayanan" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TxtNamaLayanan" class="form-label"></label>
                    <input asp-for="TxtNamaLayanan" class="form-control" maxlength="100" />
                    <span asp-validation-for="TxtNamaLayanan" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="TxtSatuan" class="form-label"></label>
                    <select asp-for="TxtSatuan" class="form-select">
                        <option value="KG">KG (Kilogram)</option>
                        <option value="PCS">PCS (Satuan/Pieces)</option>
                    </select>
                    <span asp-validation-for="TxtSatuan" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DecHarga" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">Rp</span>
                        <input asp-for="DecHarga" class="form-control" type="number"
                               min="1" step="500" />
                    </div>
                    <span asp-validation-for="DecHarga" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IntEstimasiHari" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="IntEstimasiHari" class="form-control" type="number"
                               min="1" max="30" />
                        <span class="input-group-text">hari</span>
                    </div>
                    <span asp-validation-for="IntEstimasiHari" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="BolActive" class="form-check-input" type="checkbox" />
                    <label asp-for="BolActive" class="form-check-label">
                        Layanan Aktif
                    </label>
                </div>
                <small class="text-muted">
                    Jika dinonaktifkan, layanan ini tidak akan muncul di form order baru.
                </small>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Simpan Perubahan
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Batal
                </a>
            </div>
        </form>
    </div>
</div>

